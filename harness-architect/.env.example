# 키 없이도 로컬 임베딩 폴백으로 RAG 추천이 돈다.
# LLM/임베딩 키는 화면(설정)에서 등록·암호화 저장한다 — 서버 env 키는 쓰지 않는다.

# 사용자 키 at-rest 암호화용 서버 시크릿(프로덕션 필수). 없으면 개발용 키로 암호화 + 경고.
HARNESS_SECRET_KEY=

# (선택) 추천 랭킹 근거 생성용 — env 로 두면 랭커가 heuristic→claude 로 상향. 없으면 heuristic.
ANTHROPIC_API_KEY=

# pgvector (RAG 확장 시). MVP 는 인메모리라 불필요.
DATABASE_URL=postgresql://harness:harness@localhost:5432/harness

# 카탈로그 데이터 위치. 기본은 옆 폴더(../harness-catalog/components) 자동 탐색.
# CATALOG_DIR=/path/to/harness-catalog/components

# RAG 모드 강제(테스트·재현). 기본 auto = 키 있으면 품질, 없으면 로컬 폴백.
# HARNESS_EMBEDDER=auto        # auto | local | voyage
# HARNESS_RANKER=auto          # auto | heuristic | claude
# HARNESS_EMBED_MODEL=voyage-3.5
# HARNESS_CLAUDE_MODEL=claude-sonnet-5

# ── 로그인(OAuth) ──
# 사람은 GitHub OAuth 로 로그인(웹 세션 발급), 기계(VSCode)는 설정에서 PAT 를 발급받아 붙인다.
# GitHub → Settings → Developer settings → OAuth Apps 에서 앱을 만들고 아래를 채운다.
# Authorization callback URL 은 OAUTH_REDIRECT_BASE + /auth/oauth/github/callback 로 등록.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=http://localhost:5173/api   # 콜백 베이스(개발은 웹 오리진의 /api 프록시)
# WEB_BASE_URL=http://localhost:5173              # 로그인 후 돌아올 웹 주소

# 개발 전용 로그인 — 실제 OAuth 앱 없이 이메일로 세션 발급(로컬/테스트 한정). 운영에선 켜지 말 것.
# HARNESS_DEV_AUTH=on
