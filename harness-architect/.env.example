# 키 없이도 로컬 임베딩 폴백으로 RAG 추천이 돈다. 품질 모드에서만 채운다.

# Claude — 요구사항 추출 + 랭킹 근거 생성 (claude-sonnet-5)
ANTHROPIC_API_KEY=

# Voyage AI — 임베딩 (voyage-3.5). 없으면 로컬 해싱 폴백.
VOYAGE_API_KEY=

# pgvector (RAG 확장 시). MVP 는 인메모리라 불필요.
DATABASE_URL=postgresql://harness:harness@localhost:5432/harness

# 카탈로그 데이터 위치. 기본은 옆 폴더(../harness-catalog/components) 자동 탐색.
# CATALOG_DIR=/path/to/harness-catalog/components

# RAG 모드 강제(테스트·재현). 기본 auto = 키 있으면 품질, 없으면 로컬 폴백.
# HARNESS_EMBEDDER=auto        # auto | local | voyage
# HARNESS_RANKER=auto          # auto | heuristic | claude
# HARNESS_EMBED_MODEL=voyage-3.5
# HARNESS_CLAUDE_MODEL=claude-sonnet-5
