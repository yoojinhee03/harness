# docker compose 가 자동으로 읽는 루트 .env 의 예시.
# 키 없이도 로컬 폴백으로 전 구간이 돈다 — 품질 모드에서만 채운다.
# 사용:  cp .env.example .env  후 값 입력.

# Claude — 요구 능력 추출 + 랭킹 근거 (claude-sonnet-5)
ANTHROPIC_API_KEY=

# Voyage AI — 임베딩 (voyage-3.5). 없으면 로컬 해싱 폴백.
VOYAGE_API_KEY=

# ── 로그인 ──
# 로컬에서 바로 로그인하려면(실제 OAuth 앱 없이) 아래를 켠다 — 이메일만으로 세션 발급.
# 운영에선 절대 켜지 말 것.
# HARNESS_DEV_AUTH=on
#
# 실제 GitHub 로그인 — GitHub → Settings → Developer settings → OAuth Apps 에서 앱 생성.
# Authorization callback URL 은 http://localhost:8080/api/auth/oauth/github/callback (WEB_PORT 바꾸면 맞춰서).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=http://localhost:8080/api
# WEB_BASE_URL=http://localhost:8080

# 호스트 포트 (다른 스택과 충돌하면 바꾼다). 기본 웹 8080 · API 8000.
# WEB_PORT=8080
# API_PORT=8000

# ── 카탈로그 harvest (DB 백엔드) ──
# 손큐레이션 13개를 표준 소스로 확장. 백그라운드 스케줄러가 harvest→DB 적재, **서빙은 DB 만 읽어 즉시**
# 응답한다(요청 경로에 네트워크 없음). off 면 로컬 13개. 키 불필요(read 공개).
HARNESS_LIVE_REGISTRY=on          # harvest: 공식 MCP 레지스트리(registry.modelcontextprotocol.io)
HARNESS_MARKETPLACE=on            # harvest: 플러그인 마켓플레이스(claude-plugins-official, skill·hook)
HARNESS_REGISTRY_ENRICH_MAX=0     # caps LLM 보강: 0=끔. 켜려면 150 등(+ ANTHROPIC_API_KEY 있어야 동작)
HARNESS_CATALOG_SYNC_INTERVAL=21600  # harvest 주기(초, 6h). 첫 기동엔 DB 비어있어 즉시 1회 수집
# HARNESS_REGISTRY_MAX_PAGES=50   # 레지스트리 페이지 상한(줄이면 harvest 빨라짐, 서버 수 줄어듦)
