# docker compose 가 자동으로 읽는 루트 .env 의 예시.
# 키 없이도 로컬 폴백으로 전 구간이 돈다 — 품질 모드에서만 채운다.
# 사용:  cp .env.example .env  후 값 입력.
#
# ⚠️ 이 파일은 `harness-architect/apps/api/tests/test_env_example.py` 가 코드와 대조한다 —
#    새 환경변수를 읽는 코드를 넣으면 여기에도 적어야 테스트가 통과한다(문서 드리프트 방지).

# ── LLM / 임베딩 키 (없으면 로컬 폴백) ──
# Claude — 요구 능력 추출 + 랭킹 근거 (기본 claude-sonnet-5)
ANTHROPIC_API_KEY=
# OpenAI — 임베딩(text-embedding-3-small) + LLM 대안. 없으면 로컬 해싱 임베더로 폴백.
OPENAI_API_KEY=
# HARNESS_EMBEDDER=auto            # auto | local | openai
# HARNESS_RANKER=auto              # auto | heuristic | claude
# HARNESS_CLAUDE_MODEL=claude-sonnet-5
# HARNESS_OPENAI_EMBED_MODEL=text-embedding-3-small
# 추천 카드 관련성 하한. 절대 임계값이라 임베더를 바꾸면 재보정 대상.
# HARNESS_RELEVANCE_FLOOR=0.20
# 웹검색(Tavily) 키는 앱 설정 화면에서 등록한다(env 아님).

# ── 서버 시크릿 (사용자 API 키 at-rest 암호화) ──
# ⚠️ 미설정이면 새 키 저장이 400 으로 거부된다. 예전엔 공개된 고정 키로 조용히 암호화했는데
#    그건 암호화가 아니다. /ready 의 insecure_secret 으로 상태를 확인할 수 있다.
#    생성 예: openssl rand -hex 32
HARNESS_SECRET_KEY=
# HARNESS_ALLOW_INSECURE_SECRET=on  # 로컬에서 시크릿 없이 강행(운영 금지)

# ── 로그인 ──
# 로컬에서 바로 로그인하려면(실제 OAuth 앱 없이) 아래를 켠다 — 이메일만으로 세션 발급.
# 운영에선 절대 켜지 말 것.
# HARNESS_DEV_AUTH=on
#
# 실제 GitHub 로그인 — GitHub → Settings → Developer settings → OAuth Apps 에서 앱 생성.
# Authorization callback URL 은 http://localhost:8080/api/auth/oauth/github/callback (WEB_PORT 바꾸면 맞춰서).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=http://localhost:8080/api
# WEB_BASE_URL=http://localhost:8080

# ── 호스트 포트 / 저장소 ──
# 다른 스택과 충돌하면 바꾼다. 기본 웹 8080 · API 8000.
# WEB_PORT=8080
# API_PORT=8000
# 저장소 DB. 비우면 SQLite(HARNESS_STORE_DIR 밑). compose 는 pgvector 를 기본으로 준다.
# DATABASE_URL=
# HARNESS_STORE_DIR=
# compose 의 DB 자격증명 — DATABASE_URL 기본값이 이 셋을 참조한다(따로 두면 조용히 어긋난다).
# POSTGRES_USER=harness
# POSTGRES_PASSWORD=harness
# POSTGRES_DB=harness
# SSE 팬아웃용(멀티 워커 스케일아웃). 비우면 단일 프로세스 인메모리.
# REDIS_URL=

# ── 카탈로그 harvest (DB 백엔드) ──
# 손큐레이션 13개를 표준 소스로 확장. 백그라운드 스케줄러가 harvest→DB 적재, **서빙은 DB 만 읽어 즉시**
# 응답한다(요청 경로에 네트워크 없음). off 면 로컬 13개. 키 불필요(read 공개).
HARNESS_LIVE_REGISTRY=on          # harvest: 공식 MCP 레지스트리(registry.modelcontextprotocol.io)
HARNESS_MARKETPLACE=on            # harvest: 플러그인 마켓플레이스(claude-plugins-official, skill·hook)
HARNESS_REGISTRY_ENRICH_MAX=0     # caps LLM 보강: 0=끔. 켜려면 150 등(+ ANTHROPIC_API_KEY 있어야 동작)
# 하이브리드 — 평소엔 증분(updated_since 로 바뀐 것만), 주기적으로 전체 대조(삭제 정합·드리프트 정리)
HARNESS_CATALOG_SYNC_INTERVAL=3600   # 증분 harvest 주기(초, 1h)
HARNESS_CATALOG_FULL_INTERVAL=86400  # 전체 대조 주기(초, 24h)
# HARNESS_REGISTRY_MAX_PAGES=50   # 레지스트리 페이지 상한(줄이면 harvest 빨라짐, 서버 수 줄어듦)
# HARNESS_REGISTRY_TTL=300        # 라이브 소스 캐시 신선도(초)
# HARNESS_REGISTRY_URL=https://registry.modelcontextprotocol.io
# HARNESS_MARKETPLACE_URL=        # 비우면 anthropics/claude-plugins-official
# SkillsMP — Agent Skill(SKILL.md) 메타 소스. MCP 레지스트리·마켓플레이스가 못 채우는 skill 타입 보완.
# ⚠️ API 가 **메타데이터만** 주고 본문(SKILL.md)은 안 준다 → 수확된 skill 은 body 가 비어 있고
#    그대로 eject 하면 껍데기 SKILL.md 가 나간다(이미터가 skill.body 손실로 선언 → verify 가 표면화).
# ⚠️ `q` 가 필수라 전체 열거가 불가능해 통제어휘를 질의어로 쓴다. 쿼터: 익명 50/day, 인증 500/day.
# HARNESS_SKILLSMP=on
# HARNESS_SKILLSMP_KEY=            # 있으면 쿼터 50/day → 500/day
# HARNESS_SKILLSMP_MAX_QUERIES=8   # 질의 수 상한(쿼터 예측 가능하게)
# 제로샷 caps 태깅 — semantic 임베더(OPENAI_API_KEY) 필요. 활성화 전 eval_zeroshot.py 로 재보정할 것.
# HARNESS_CAPS_ZEROSHOT=off
# HARNESS_CAPS_ZEROSHOT_THRESHOLD=0.35

# ── 피드백 루프 (Phase 9) ──
# 실사용 keep/drop 을 모아 랭킹의 usage/retention 을 채운다. **기본 꺼짐** — 켜지 않은 수집으로
# 추천 품질이 조용히 달라지면 안 된다. 꺼짐이면 아무것도 기록하지 않고 랭킹도 불변.
# HARNESS_FEEDBACK=on

# ── 운영 ──
# HARNESS_LOG_LEVEL=INFO
# 레이트리밋 — HEAVY 는 LLM 호출·외부 요청이 붙는 경로, STANDARD 는 경량 경로.
# HARNESS_RATELIMIT=on              # off 로 전체 비활성화(테스트·단일 사용자 로컬)
# HARNESS_RATELIMIT_STANDARD=60/minute
# HARNESS_RATELIMIT_HEAVY=30/minute
# 크로스 오리진으로 API 를 직접 노출할 때만(쉼표 구분). 같은 오리진 프록시면 불필요.
# HARNESS_CORS_ORIGINS=
# SENTRY_DSN=
# SENTRY_TRACES=0.0

# ── 개발용 경로 오버라이드 (보통 자동 탐색으로 충분) ──
# CATALOG_DIR=       # 카탈로그 components 디렉터리
# RECIPES_DIR=       # 레시피 디렉터리
# RANK_EVAL_GOLDEN=  # 랭킹 골든셋 YAML
# EVALS_DIR=         # 프롬프트 eval 시나리오 디렉터리
